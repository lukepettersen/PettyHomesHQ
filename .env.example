# Copy to .env for local development. In production these live ONLY in Railway variables.
# Never commit real values.

# Postgres (Railway provides this automatically when you add the Postgres service)
DATABASE_URL=

# Auth.js
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only accounts on this Google Workspace domain can sign in
ALLOWED_EMAIL_DOMAIN=pettyhomes.com

# Texting (Phase 4). Leave blank: texting stays off until these are set.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Follow Up Boss (only for copying notes and history; people import uses a CSV export)
FUB_API_KEY=

# File storage (private S3-compatible bucket for the Files card)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
